{
  "manifest_version": 3,
  "name": "FNx Signal Pro - Live Quotex Bridge",
  "version": "2.0",
  "description": "Zero-risk live price bridge for FNx Signal Pro",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FNx Signal Pro Bridge"
  }
}